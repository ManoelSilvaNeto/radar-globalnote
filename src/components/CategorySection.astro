---
import type { CategoriaSecao } from '../lib/types';
import StoryCard from './StoryCard.astro';

interface Props {
  categoria: CategoriaSecao;
  limit?: number;
}

const { categoria, limit = 4 } = Astro.props;
const shown = categoria.stories.slice(0, limit);
---

{
  shown.length > 0 && (
    <section class="mt-10">
      <div class="flex items-baseline justify-between border-b-2 border-neutral-900 pb-1 dark:border-neutral-100">
        <h2 class="font-serif text-xl font-bold">{categoria.label}</h2>
        <a href={`/${categoria.slug}`} class="text-sm text-sky-700 hover:underline dark:text-sky-400">ver tudo →</a>
      </div>
      {shown.map((story) => <StoryCard story={story} />)}
    </section>
  )
}
