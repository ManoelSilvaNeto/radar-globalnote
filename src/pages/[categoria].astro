---
import Layout from '../layouts/Layout.astro';
import StoryList from '../components/StoryList.astro';
import { allCategorias, storiesByCategoria } from '../lib/data';
import { itemListJsonLd } from '../lib/seo';

export function getStaticPaths() {
  // Uma página por categoria DINÂMICA presente (atual + arquivo).
  return allCategorias.map((c) => ({ params: { categoria: c.slug }, props: { label: c.label } }));
}

const { categoria } = Astro.params as { categoria: string };
const { label } = Astro.props as { label: string };
const stories = storiesByCategoria(categoria);
const pageUrl = new URL(Astro.url.pathname, Astro.site!).href;
const description = `Notícias de ${label.toLowerCase()} — resumidas e organizadas, com link para as fontes.`;
const jsonLd = [itemListJsonLd(stories, pageUrl)];
const ogImage = stories.find((s) => s.imageUrl)?.imageUrl;
---

<Layout title={label} description={description} image={ogImage} jsonLd={jsonLd}>
  <h1 class="border-b-2 border-neutral-900 pb-1 font-serif text-2xl font-bold dark:border-neutral-100">{label}</h1>
  <div class="mt-2">
    <StoryList stories={stories} />
  </div>
</Layout>
